# Cloudflare Pages cache policy:
# hashed build assets are immutable; the SW + HTML must always revalidate so
# new versions propagate the moment a client checks.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
