{
  "name": "sculptpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Touch-first 3D asset studio for iPad (PWA) \u2014 blockout, sculpt, pose, paint, export.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "dev:lan-https": "LAN_HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:anatomy": "node scripts/anatomy-smoke.mjs",
    "deploy": "node scripts/deploy.mjs",
    "smoke:update": "node scripts/update-smoke.mjs",
    "smoke:pose": "node scripts/pose-smoke.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "smoke:gestures": "node scripts/gesture-smoke.mjs"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "manifold-3d": "^3.0.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "wrangler": "^4.118.0"
  }
}
